{
  "expo": {
    "name": "TOEM HIA",
    "slug": "toem-hia",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "toemhia",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", ["expo-secure-store", { "configureAndroidBackup": true }]],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.toemhia.mobile", "config": { "usesNonExemptEncryption": false } },
    "android": { "package": "com.toemhia.mobile" },
    "web": { "bundler": "metro" }
  }
}
