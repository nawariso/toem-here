# Copy to .env.local and replace placeholders. Never commit .env.local.
APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://toem_here:replace-with-local-only-password@localhost:5432/toem_here?sslmode=disable
AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
POSTGRES_USER=toem_here
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_DB=toem_here

# Public mobile values only. The publishable key is designed for clients;
# never put a Supabase secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8080
